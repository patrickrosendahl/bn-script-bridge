#!/usr/bin/env python3
"""Run a Python script inside the running Binary Ninja app through the script bridge.

    bnrun [--view SUBSTRING] [--main-thread] [--json] [--timeout SECONDS]
          [--bndb PATH] [--env K=V ...] [--max-out N] [SCRIPT | -e CODE] [-- ARG ...]
    bnrun --parallel [--json] [--timeout SECONDS] [SCRIPT | -e CODE]
    bnrun --status [--json]                            (usage lock, running/queued/lost jobs)
    bnrun --detach [...] [SCRIPT | -e CODE]            (submit, print the job's run id, exit)
    bnrun --wait RUN_ID                                (wait for a job and print its output)
    bnrun --jobs                                       (this session's jobs + lost ones)
    bnrun --requeue RUN_ID ...|all [--force]           (rerun lost jobs, then wait for them)
    bnrun --forget RUN_ID ...|all                      (drop lost jobs)
    bnrun --cancel [--force]                           (cancel running scripts)
    bnrun --lock [--purpose TEXT] [--ttl MINUTES]      (take or renew for this session)
    bnrun --unlock [--force]
    bnrun --bndb-list                                  (cached headless views)
    bnrun --bndb-save [PATH]                           (save cached view(s) into their .bndb)
    bnrun --bndb-close [PATH]                          (close and drop cached view(s))

SCRIPT defaults to stdin. Ending in .py it is a file (check.py, /abs/check.py); anything else
names a bundled script (scripts/<name>.py in this repo): annotate (R:/D:/C: renames and comments),
info (F:/S: function and settings queries), decompile (un-skip + HLIL); each documents its
arguments at the top, e.g. `bnrun --bndb /abs/x.bndb annotate -- R:0x401000:parse_header`.

Every script sees `binaryninja`/`bn`; print() output comes back, and so does `result` if the
script sets it; sys.exit("message") fails with that message instead of a traceback. Exit
status: 0 ok, 1 script error (or cancelled), 2 bridge unreachable or refused, 3 Binary Ninja
is locked by someone else, 4 job lost (its Binary Ninja stopped before it finished; see Jobs),
130 interrupted (Ctrl-C; the script is cancelled in Binary Ninja too).

Arguments and environment: everything after a standalone `--` is the script's argv (argv[0] is
the script filename, or "<bnrun>" for -e/stdin), given to the script as `argv` and, for a
serialized run, also as sys.argv; --env K=V forwards environment variables (given as `env`, and
merged into os.environ for a serialized run; restored after). Parallel scripts overlap, so they
get the bare `argv`/`env` names only.

UI views need the usage lock: only a serialized script of the session holding the lock (bnrun
--lock) gets `bv` (the view whose filename contains --view SUBSTRING, or the one active in the
UI) and `bvs` (all views open in the UI); --view and --main-thread are refused without the lock.
Without it, `bv`/`bvs` raise UIViewsUnavailable when used. Scripts that only create their own
views (BinaryViewType[...].create(BinaryView.open(path)), binaryninja.load) need no lock.

--bndb PATH opens that file headlessly (a .bndb opens its database and carries renames; a raw
binary is analysed once), caches the view and hands it to the script as `bv` -- no usage lock
needed. Cached views are shared, so --bndb runs go through the serialized lane and can't be
combined with --view, --main-thread or --parallel. `bvs` stays unavailable (the UI views need
the lock); the cache outlives the script: --bndb-list shows it, --bndb-save writes renames etc.
back into the .bndb (or materializes one for a raw binary), --bndb-close frees the memory.
Binary Ninja's Stop closes the cache without saving; bnrestart saves it first.

Lanes: by default scripts run one at a time (serialized; later ones queue). --parallel runs the
script next to the serialized one and other parallel ones (at most scriptbridge.maxParallel,
default 4; more wait for a slot). Rule of thumb: UI views / shared state -> serialized + usage
lock; own throwaway views -> --parallel, no lock needed. Parallel scripts get no UI views (no
`bv`/`bvs`/--view, no --main-thread) and must not touch UI-opened views, the MCP active view or
save databases.

Cancelling: Ctrl-C (or SIGTERM) while waiting cancels this script inside Binary Ninja.
--timeout SECONDS makes the bridge cancel it when it runs longer. --cancel cancels the running
scripts this session started; with none, the lock holder (or --force) cancels all running ones.
Cancellation lands between Python bytecodes: a script blocked in a long native call
(bv.update_analysis_and_wait(), time.sleep()) stops only when that call returns.

Jobs: bnrun submits the script as a job and polls the bridge for its result, so it never
gives up on a job it submitted: no client timeout, also while the job waits in the queue (only
--timeout, counted from when the script starts, stops it). If the bridge goes away while
waiting, bnrun keeps retrying for 5 minutes (a restarted Binary Ninja is picked up), then
exits 2 printing the run id for `bnrun --wait RUN_ID`. --detach prints the run id and exits at
once. Ctrl-C cancels the job only for the bnrun that submitted it; under --wait it just stops
waiting. Finished jobs keep their output for an hour.
Lost jobs: jobs queued or running when Binary Ninja died or stopped are kept on disk and
reported ("lost" in --status, --jobs); none is rerun on its own. --requeue reruns them as new
jobs of this session; one that was already running needs --force (it may have applied part of
its edits, or be what wedged Binary Ninja). --forget drops them. Waiting on a lost job exits 4.

Usage lock: no lock = Binary Ninja is free; a lock = one session is busy. The session is
--session (default $CLAUDE_CODE_SESSION_ID), shown as --name (default $BN_SESSION_NAME). While
another session holds the lock, scripts are refused; the holder's scripts renew it. Locks
expire after --ttl minutes (default 5) unless renewed. The same lock gates Binary Ninja's MCP
tools through the MCP proxy (bn_owner_get / bn_owner_set). Coordination, not security.

--max-out N truncates stdout+result to N characters on the terminal; the full output goes to
~/.cache/bn-script-bridge/bnrun-<timestamp>.txt and the last line points at it. Script errors
(tracebacks on stderr) are never truncated.

Config (port + token) is read from $BN_SCRIPT_BRIDGE_CONFIG or
~/Library/Application Support/Binary Ninja/script_bridge.json.
"""

import argparse
import json
import os
import secrets
import signal
import sys
import time
import urllib.error
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from bridge_server import describe, describe_lost, describe_run, describe_runs  # noqa: E402

DEFAULT_CONFIG = os.path.expanduser("~/Library/Application Support/Binary Ninja/script_bridge.json")
SCRIPTS_DIR = os.path.join(os.path.dirname(os.path.realpath(__file__)), "scripts")


def bundled_scripts():
    try:
        return sorted(n[:-3] for n in os.listdir(SCRIPTS_DIR) if n.endswith(".py"))
    except FileNotFoundError:
        return []


def resolve_script(name):
    """The file to run for SCRIPT: ending in .py it is a file; anything else names a bundled
    script (`annotate` -> scripts/annotate.py), None if there is no such one."""
    if name.endswith(".py"):
        return name
    return os.path.join(SCRIPTS_DIR, name + ".py") if name in bundled_scripts() else None


def _split_script_args(argv):
    """(parser args, script args): everything after the first standalone `--` is the script's,
    so options there (e.g. a negative number) never reach this parser."""
    if "--" in argv:
        i = argv.index("--")
        return argv[:i], argv[i + 1:]
    return argv, []


def main() -> int:
    parser_argv, script_args = _split_script_args(sys.argv[1:])
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0],
                                 epilog=__doc__.split("\n", 2)[2],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("script", nargs="?", help="script file (*.py) or "
                    "bundled script name (default: stdin)")
    ap.add_argument("-e", dest="code", help="code to run instead of a file")
    ap.add_argument("--view", help="select the open view whose filename contains this")
    ap.add_argument("--main-thread", action="store_true", help="run on the UI thread "
                    "(needs the usage lock)")
    ap.add_argument("--parallel", action="store_true", help="run next to other scripts instead "
                    "of one at a time; only for scripts working on their own views (no bv/bvs)")
    ap.add_argument("--bndb", help="open this file headlessly (a .bndb opens its database; a "
                    "raw binary is analysed once), cache the view and run with it as `bv`; no "
                    "usage lock needed")
    ap.add_argument("--env", action="append", default=[], metavar="K=V", help="environment "
                    "variable for the script (repeatable)")
    ap.add_argument("--max-out", type=int, help="truncate stdout+result to this many characters "
                    "on the terminal; the full output goes to a file (see --help)")
    ap.add_argument("--json", action="store_true", help="print the raw JSON response (also "
                    "with --status and --jobs)")
    ap.add_argument("--detach", action="store_true", help="submit the job, print its run id "
                    "and exit (collect it with --wait RUN_ID)")
    ap.add_argument("--timeout", type=float, help="cancel the script in Binary Ninja after "
                                                  "this many seconds of running")
    ap.add_argument("--session", default=os.environ.get("CLAUDE_CODE_SESSION_ID"),
                    help="this session's identity (default $CLAUDE_CODE_SESSION_ID)")
    ap.add_argument("--name", default=os.environ.get("BN_SESSION_NAME", ""),
                    help="display name for the lock (default $BN_SESSION_NAME)")
    lock = ap.add_mutually_exclusive_group()
    lock.add_argument("--status", action="store_true", help="show the usage lock")
    lock.add_argument("--lock", action="store_true", help="take or renew the lock")
    lock.add_argument("--unlock", action="store_true", help="release this session's lock")
    lock.add_argument("--cancel", action="store_true", help="cancel this session's running "
                      "scripts (with none: all running ones, as lock holder or with --force)")
    lock.add_argument("--bndb-list", action="store_true", help="list the cached headless views")
    lock.add_argument("--bndb-save", nargs="?", const="", metavar="PATH", help="save cached "
                      "view(s) into their .bndb (all when PATH is omitted)")
    lock.add_argument("--bndb-close", nargs="?", const="", metavar="PATH", help="close and drop "
                      "cached view(s) (all when PATH is omitted)")
    lock.add_argument("--wait", metavar="RUN_ID", help="wait for that job and print its output")
    lock.add_argument("--jobs", action="store_true", help="this session's jobs and the lost ones")
    lock.add_argument("--requeue", nargs="+", metavar="RUN_ID", help="rerun lost jobs (or all) "
                      "and wait for them; --force for ones that were running")
    lock.add_argument("--forget", nargs="+", metavar="RUN_ID", help="drop lost jobs (or all)")
    ap.add_argument("--purpose", default="", help="with --lock: what you are doing")
    ap.add_argument("--ttl", type=float, help="with --lock: minutes until it expires (default 5)")
    ap.add_argument("--force", action="store_true", help="with --unlock: release someone "
                    "else's lock (stale locks); with --cancel: cancel someone else's script; "
                    "with --requeue: also rerun jobs that were running when they were lost")
    args = ap.parse_args(parser_argv)
    if args.parallel and args.main_thread:
        ap.error("--parallel can't be combined with --main-thread (parallel scripts run on "
                 "their own worker thread; UI work goes through the serialized lane)")
    if args.parallel and args.view:
        ap.error("--parallel can't be combined with --view (parallel scripts get no UI views; "
                 "UI work goes through the serialized lane with the usage lock)")
    if args.bndb:
        if args.view:
            ap.error("--bndb can't be combined with --view (a --bndb run works on its own "
                     "cached headless view)")
        if args.main_thread:
            ap.error("--bndb can't be combined with --main-thread (headless run, no UI "
                     "objects)")
        if args.parallel:
            ap.error("--bndb can't be combined with --parallel (cached views are shared, so "
                     "--bndb runs serialize)")
        if not os.path.isfile(args.bndb):
            ap.error("--bndb file not found: %s" % args.bndb)
        args.bndb = os.path.abspath(args.bndb)     # Binary Ninja's cwd isn't ours
    env_vars = {}
    for item in args.env:
        key, sep, value = item.partition("=")
        if not sep or not key:
            ap.error("--env expects K=V")
        env_vars[key] = value
    if args.max_out is not None and args.max_out < 1:
        ap.error("--max-out must be at least 1")

    if args.cancel:
        return cancel_command(args)
    if args.wait:
        return wait_command(args)
    if args.jobs:
        return jobs_command(args)
    if args.requeue or args.forget:
        return lost_command(args)
    if args.bndb_list or args.bndb_save is not None or args.bndb_close is not None:
        return bndb_command(args)
    if args.status or args.lock or args.unlock:
        return lock_command(args)

    if args.code is not None:
        code = args.code
    elif args.script and args.script != "-":
        path = resolve_script(args.script)
        if path is None:
            ap.error("no bundled script %r (bundled: %s); a file must end in .py"
                     % (args.script, ", ".join(bundled_scripts()) or "none"))
        args.script = path
        code = open(path).read()
    else:
        code = sys.stdin.read()

    run_id = secrets.token_hex(16)    # lets Ctrl-C cancel exactly this run
    argv0 = args.script if args.script and args.script != "-" else "<bnrun>"
    body = {"code": code, "view": args.view, "main_thread": args.main_thread,
            "parallel": args.parallel, "bndb": args.bndb, "args": [argv0] + script_args,
            "env": env_vars or None, "session": args.session, "name": args.name,
            "timeout": args.timeout, "run_id": run_id}
    signal.signal(signal.SIGTERM, _raise_interrupt)
    try:
        status, reply = submit(body, args)
        if status == 202:
            if args.detach:
                print(run_id)
                return 0
            status, reply = wait_job(run_id)
    except KeyboardInterrupt:
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        signal.signal(signal.SIGINT, signal.SIG_IGN)    # don't abort the cancel itself
        status, _ = call("/cancel", {"run_id": run_id, "session": args.session}, 10)
        print("\nbnrun: interrupted; %s" % ("script cancelled in Binary Ninja" if status == 200
                                             else "couldn't cancel the script (see above)"),
              file=sys.stderr)
        return 130
    return render(status, reply, args)


def submit(body, args):
    """(status, reply) of submitting the run: 202 = a job to wait for; a bridge from before
    the job protocol (no "jobs" in /ping) runs it in one request held open to the end."""
    status, ping = call("/ping", timeout=10)
    if status != 200:
        return status, {}
    if not ping.get("jobs"):
        if args.detach:
            print("bnrun: this bridge can't --detach (restart Binary Ninja to load the new "
                  "plugin)", file=sys.stderr)
            return 2, {}
        return call("/run", body, None, passthrough=(400, 409, 423))
    for attempt in range(3):    # resubmitting the same run_id never runs it twice
        status, reply = call("/run", dict(body, **{"async": True}), 30,
                             passthrough=(400, 409, 423))
        if status != 0:
            return status, reply
        time.sleep(2)
    return status, reply


GIVE_UP_AFTER = 300     # seconds of an unreachable bridge before wait_job stops waiting


def wait_job(run_id):
    """Poll /result until the job is done: (200, its /run reply), (404|"lost", ...) or 2."""
    unreachable_since = None
    while True:
        status, reply = call("/result", {"run_id": run_id, "wait": 25}, 40,
                             passthrough=(404,), quiet=unreachable_since is not None)
        if status == 200:
            if unreachable_since is not None:
                print("bnrun: bridge back; still waiting for job %s" % run_id, file=sys.stderr)
            unreachable_since = None
            if reply.get("state") == "done":
                return 200, reply["reply"]
            if reply.get("state") == "lost":
                return "lost", reply
            continue
        if status == 404:
            return 404, reply
        now = time.time()
        if unreachable_since is None:
            unreachable_since = now
            print("bnrun: still waiting for job %s; retrying for %d minutes (Ctrl-C cancels it)"
                  % (run_id, GIVE_UP_AFTER // 60), file=sys.stderr)
        elif now - unreachable_since > GIVE_UP_AFTER:
            print("bnrun: gave up waiting: bridge unreachable for %d minutes. The job may still "
                  "be queued or running; check with: bnrun --wait %s" % (GIVE_UP_AFTER // 60,
                                                                       run_id), file=sys.stderr)
            return 0, {}
        time.sleep(2)


def render(status, reply, args) -> int:
    """Print a finished job's reply (or the refusal) and return the exit status."""
    if status == "lost":
        lost = reply.get("lost") or {}
        print("bnrun: job %s lost: %s.\nRerun it with: bnrun --requeue %s%s"
              % (lost.get("run_id"), describe_lost(lost), lost.get("run_id"),
                 "" if lost.get("state") == "queued" else " --force (check first: it was "
                 "already running, so part of it may have been applied)"), file=sys.stderr)
        return 4
    if status == 404:
        print("bnrun: %s" % reply.get("error"), file=sys.stderr)
        return 1
    if status == 423:
        print("bnrun: Binary Ninja is %s" % describe(reply["lock"]), file=sys.stderr)
        return 3
    if status in (400, 409):
        print("bnrun: refused: %s" % reply.get("error"), file=sys.stderr)
        return 2
    if status != 200:
        return 2

    if args.json:
        text = json.dumps(reply, indent=2)
    else:
        text = reply.get("stdout") or ""
        if reply.get("result") is not None:
            rendered = json.dumps(reply["result"], indent=2) \
                if not isinstance(reply["result"], str) else reply["result"]
            text += rendered if (not text or text.endswith("\n")) else "\n" + rendered
        if reply.get("error") == "cancelled":
            print("bnrun: script cancelled (by %s)" % reply.get("cancelled_by"), file=sys.stderr)
        elif reply.get("error"):
            sys.stderr.write(reply["error"])
    if args.max_out is not None and len(text) > args.max_out:
        path = _write_full_output(text)
        sys.stdout.write(text[:args.max_out])
        sys.stdout.write("\nbnrun: truncated at %d characters; full output: %s\n"
                         % (args.max_out, path))
    else:
        sys.stdout.write(text if text.endswith("\n") or not text else text + "\n")
    return 0 if reply.get("ok") else 1


def _write_full_output(text: str) -> str:
    import time as _time

    cache_dir = os.path.expanduser("~/.cache/bn-script-bridge")
    os.makedirs(cache_dir, exist_ok=True)
    path = os.path.join(cache_dir, "bnrun-%d.txt" % int(_time.time() * 1000))
    with open(path, "w") as f:
        f.write(text)
    return path


def _raise_interrupt(*_args):
    raise KeyboardInterrupt


def call(path, body=None, timeout=30.0, passthrough=(409, 423), quiet=False):
    """(HTTP status, JSON reply); status 0 and a printed message (unless quiet) if the bridge
    is unusable or doesn't answer in time. Error statuses in `passthrough` return their JSON
    reply without printing anything."""
    config_path = os.environ.get("BN_SCRIPT_BRIDGE_CONFIG", DEFAULT_CONFIG)
    try:
        config = json.load(open(config_path))
    except (FileNotFoundError, ValueError):     # missing, or half-written by a starting bridge
        if not quiet:
            print("bnrun: %s not found; start the bridge in Binary Ninja "
                  "(Plugins > Script Bridge > Start)" % config_path, file=sys.stderr)
        return 0, {}
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        "http://127.0.0.1:%d%s" % (config["port"], path), data=data,
        method="POST" if data is not None else "GET",
        headers={"Authorization": "Bearer " + config["token"], "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.load(resp)
    except urllib.error.HTTPError as e:
        text = e.read().decode(errors="replace")
        if e.code in passthrough:
            return e.code, json.loads(text)
        print("bnrun: refused (%d): %s" % (e.code, text), file=sys.stderr)
        return e.code, {}
    except (urllib.error.URLError, ConnectionError, TimeoutError, OSError) as e:
        if not quiet:
            print("bnrun: bridge unreachable: %s" % e, file=sys.stderr)
        return 0, {}


def lock_command(args) -> int:
    if args.status:
        status, reply = call("/lock")
        if status != 200:
            return 2
        if args.json:
            print(json.dumps(reply, indent=2))
            return 3 if reply["lock"].get("locked") else 0
        print(describe(reply["lock"]))
        print(describe_runs(reply))
        return 3 if reply["lock"].get("locked") else 0
    if args.lock:
        if not args.session:
            print("bnrun: no session identity; pass --session or set CLAUDE_CODE_SESSION_ID",
                  file=sys.stderr)
            return 2
        status, reply = call("/lock", {"session": args.session, "name": args.name,
                                       "purpose": args.purpose,
                                       "ttl": args.ttl * 60 if args.ttl else None})
        if status == 409:
            print("bnrun: Binary Ninja is %s" % describe(reply["lock"]), file=sys.stderr)
            return 3
        if status != 200:
            return 2
        print(describe(reply["lock"]))
        return 0
    status, reply = call("/unlock", {"session": args.session, "force": args.force})
    if status == 409:
        print("bnrun: %s" % reply["error"], file=sys.stderr)
        return 3
    if status != 200:
        return 2
    print("released" if reply["released"].get("locked") else "was already free")
    return 0


def bndb_command(args) -> int:
    if args.bndb_list:
        status, reply = call("/run")
        if status != 200:
            return 2
        cached = reply.get("bndb") or []
        if not cached:
            print("no cached views")
        for view in cached:
            print(view["path"])
        return 0
    action = "save" if args.bndb_save is not None else "close"
    path = args.bndb_save if action == "save" else args.bndb_close
    timeout = 300 if action == "save" else 30    # a save can write a whole .bndb
    status, reply = call("/bndb", {"action": action,
                                   "path": os.path.abspath(path) if path else None,
                                   "session": args.session}, timeout,
                         passthrough=(404, 409, 423))
    if status == 423:
        print("bnrun: Binary Ninja is %s" % describe(reply["lock"]), file=sys.stderr)
        return 3
    if status in (400, 404, 409):
        print("bnrun: %s" % reply.get("error"), file=sys.stderr)
        return 1
    if status != 200:
        return 2
    for entry in reply.get("results") or []:
        verb = "saved" if action == "save" else "closed"
        if entry["ok"]:
            print("%s %s" % (verb, entry["path"]))
        else:
            print("FAILED %s: %s" % (entry["path"], entry.get("error")), file=sys.stderr)
    return 0 if reply.get("ok") else 1


def wait_command(args) -> int:
    try:
        status, reply = wait_job(args.wait)
    except KeyboardInterrupt:
        print("\nbnrun: stopped waiting; job %s goes on (bnrun --wait %s)" % (args.wait,
                                                                             args.wait),
              file=sys.stderr)
        return 130
    return render(status, reply, args)


def jobs_command(args) -> int:
    status, reply = call("/jobs", {"session": args.session})
    if status != 200:
        return 2
    if args.json:
        print(json.dumps(reply, indent=2))
        return 0
    jobs, lost = reply.get("jobs") or [], reply.get("lost") or []
    if not jobs and not lost:
        print("no jobs")
    for job in jobs:
        if job["state"] == "done":
            outcome = "ok" if job.get("ok") else (job.get("error") or "failed").splitlines()[-1]
            print("%s  done %ds ago: %s  %r" % (job["run_id"], job.get("finished_ago", 0),
                                               outcome[:80], job["label"]))
        else:
            print("%s  %s" % (job["run_id"], describe_run(job)))
    for rec in lost:
        print("%s  %s" % (rec["run_id"], describe_lost(rec)))
    return 0


def lost_command(args) -> int:
    action = "requeue" if args.requeue else "forget"
    ids = args.requeue or args.forget
    status, reply = call("/lost", {"action": action,
                                   "run_ids": "all" if ids == ["all"] else ids,
                                   "force": args.force, "session": args.session,
                                   "name": args.name})
    if status != 200:
        return 2
    new_ids = []
    for entry in reply.get("results") or []:
        if not entry["ok"]:
            print("bnrun: %s: %s" % (entry["run_id"], entry.get("error")), file=sys.stderr)
        elif action == "forget":
            print("forgot %s" % entry["run_id"])
        else:
            print("requeued %s as %s: %r" % (entry["run_id"], entry["new_run_id"],
                                             entry.get("label")), file=sys.stderr)
            new_ids.append(entry["new_run_id"])
    if not reply.get("results"):
        print("no lost jobs")
    worst = 0 if reply.get("ok") else 1
    if args.detach:
        for run_id in new_ids:
            print(run_id)
        return worst
    for run_id in new_ids:
        try:
            status, job_reply = wait_job(run_id)
        except KeyboardInterrupt:
            print("\nbnrun: stopped waiting; the requeued jobs go on: %s" % " ".join(new_ids),
                  file=sys.stderr)
            return 130
        worst = max(worst, render(status, job_reply, args))
    return worst


def cancel_command(args) -> int:
    status, reply = call("/cancel", {"session": args.session, "force": args.force},
                         passthrough=(403, 409))
    if status == 200:
        for run in reply.get("cancelled_runs") or [reply["cancelled"]]:
            print("cancel sent: %s" % describe_run(run))
        return 0
    if status in (403, 409):
        print("bnrun: %s" % reply["error"], file=sys.stderr)
        return 3 if status == 403 else 1
    return 2


